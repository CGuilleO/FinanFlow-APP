{
  "id": "/?source=pwa",
  "name": "FinanFlow AI | Gestión Financiera Inteligente",
  "short_name": "FinanFlow",
  "description": "Gestión financiera inteligente con IA, lectura automática de SMS, facturas y comprobantes compartidos.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#090D16",
  "theme_color": "#090D16",
  "orientation": "portrait-primary",
  "categories": ["finance", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nuevo Movimiento",
      "short_name": "Nuevo",
      "description": "Registrar ingreso o gasto rápidamente",
      "url": "/?action=new_tx",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Billeteras y SMS",
      "short_name": "Billeteras",
      "description": "Importar comprobante de Nequi, Daviplata o SMS",
      "url": "/?action=smart_parser",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Escanear Ticket",
      "short_name": "Escanear",
      "description": "Escanear recibo o factura con cámara IA",
      "url": "/?action=scan_ocr",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt_image",
          "accept": ["image/*", "image/jpeg", "image/png", "image/webp", "application/pdf"]
        }
      ]
    }
  }
}
